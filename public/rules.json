{"rules":{
"Taunt":{"kind":"keyword","section":"Card Keywords","text":"This card must be attacked before all other non-taunt targets if possible."},
"Silence":{"kind":"keyword","section":"Card Keywords","text":"The specified card's ability cannot be used."},
"Neutralise":{"kind":"keyword","section":"Card Keywords","text":"Send the specified card(s) to the neutralised pile.","notes":["Neutralising does not count as destroying or discarding."]},
"Helidrop":{"kind":"keyword","section":"Card Keywords","text":"This card can attack in the same turn it is played."},
"Retreat":{"kind":"keyword","section":"Card Keywords","text":"Send the specified card(s) on field to their owner's hand."},
"Rescue":{"kind":"keyword","section":"Card Keywords","text":"Choose a card of the specified type in the deck, reveal it to your opponent, then move it to your hand.","notes":["Rescuing does not count as drawing the card."]},
"Remember":{"kind":"keyword","section":"Card Keywords","text":"Choose a card of the specified type in your graveyard, reveal it to your opponent, then move it to your hand.","notes":["Remember does not count as drawing the card."]},
"Equip":{"kind":"keyword","section":"Card Keywords","text":"Choose a friendly operator and attach it underneath this card. The stats, abilities and attack status of both cards are combined.","notes":["Equipping from the field does not count as playing the card, so an Instant effect will not activate again."]},
"Hovering":{"kind":"keyword","section":"Card Keywords","text":"Can only be attacked by, and can only block medium and long ranged cards and other cards with hovering."},
"Summon":{"kind":"keyword","section":"Card Keywords","text":"Move the specified cards from the extra deck to the field in the order they are stated on the card. If there is not enough space on the field, add them to the hand."},
"Obtain":{"kind":"keyword","section":"Card Keywords","text":"Move the specified cards from the extra deck to your hand."},
"Sleeping":{"kind":"state","section":"Card States","text":"Sleeping cards cannot attack or defend, their abilities are disabled, they cannot be targeted and their countdowns do not decrease at the end of the turn. Sleeping cards are considered inactive.","notes":["Lasts until specified in the card effect, or until the card inflicting sleep is destroyed.","Sleeping cards can still be affected by non-targeting and AOE effects, and still count for 'number of cards' effects."]},
"Auto":{"kind":"ability","section":"Card Abilities","text":"Specify a time or condition and activate every time that condition is met.","notes":["These can activate on your opponent's turn if the condition is satisfied."]},
"Manual":{"kind":"ability","section":"Card Abilities","text":"This ability can be used at any time during the turn you play this card or the ability is gained. If the ability is not used, it is disabled at the end of the current turn. Manual abilities can only be used once per deployment of the card."},
"Passive":{"kind":"ability","section":"Card Abilities","text":"Apply their effects continuously, either for a set duration or until the card is destroyed, whichever comes first."},
"Instant":{"kind":"ability","section":"Card Abilities","text":"This ability must be used immediately as the card is played."},
"Active":{"kind":"ability","section":"Card Abilities","text":"Can be used once per turn, with no limit on how many times they may be used per game. Commonly found on Locations, but may exist on other cards."}
